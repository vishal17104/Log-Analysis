# ============ DATABASE ============
# For local development
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/logdb
# For Docker (comment out above, uncomment below)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/logdb

# ============ API KEYS ============
GEMINI_API_KEY=your-gemini-api-key-here

# ============ BACKEND URL ============
BACKEND_URL=http://localhost:8000
# For Docker (comment out above, uncomment below)
# BACKEND_URL=http://backend:8000

# Detector thresholds
ERROR_THRESHOLD=5
TIME_WINDOW=5
CONSECUTIVE_TIME=2

# SEVERITY THRESHOLDS
SEVERITY_CRITICAL=50
SEVERITY_HIGH=20
SEVERITY_MEDIUM=10
SEVERITY_LOW=5

# Logging
LOG_LEVEL=INFO
